# Plantilla de configuracion. Copia este fichero a .env y rellena los valores reales.

# Conexion a Actual Budget
ACTUAL_SERVER_URL=http://actual-budget:5006
ACTUAL_PASSWORD=tu_password_de_actual
ACTUAL_SYNC_ID=id_del_presupuesto_a_sincronizar

# Servidor SMTP para el envio de correos
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=usuario@tu-dominio.com
SMTP_PASS=tu_password_smtp

# Destinatarios del reporte (separados por comas)
NOTIFICATION_EMAIL=destino1@ejemplo.com,destino2@ejemplo.com

# --- Telegram (optional: empty token = email-only mode) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
TELEGRAM_MAX_TX_MESSAGES=15
TELEGRAM_POLL_TIMEOUT=30
TELEGRAM_DRY_RUN=true
DATA_DIR=/app/data
# NOTE: changing TELEGRAM_BOT_TOKEN/TELEGRAM_GROUP_ID requires `docker compose restart notifier-listener`
