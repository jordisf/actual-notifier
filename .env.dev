# Dev environment for actual-notifier (see README.md -> "Entorno de desarrollo").
# Copy this to .env before running:  node src/reporte-diario.js

ACTUAL_SERVER_URL=http://actual-budget:5006
ACTUAL_PASSWORD=dev-seed-password
# Fill after seeding:  docker compose -f actual-budget/docker-compose.yml run --rm seed
ACTUAL_SYNC_ID=<paste_groupId_from_seed_output>

# Mailpit (dev.yml overlay) as local SMTP sink
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=notifier@dev.local
SMTP_PASS=dev

NOTIFICATION_EMAIL=dev-reports@dev.local
